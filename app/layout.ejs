<!DOCTYPE html>
<html lang="fr" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="FreshBox — Flavor That Makes History. Commandez en ligne ou réservez votre table.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"/>
  <link rel="stylesheet" href="/tailwind.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-outfit {
      font-family: 'Outfit', sans-serif;
    }
    code, pre {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>
</head>

<body class="bg-[#fcf7ee] text-[#3d1508] min-h-full antialiased selection:bg-[#ffc844] selection:text-[#3d1508] transition-colors">
  <%- body %>
</body>

</html>