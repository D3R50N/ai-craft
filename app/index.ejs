<main class="w-full min-h-screen bg-slate-50 text-slate-900 p-6 sm:p-10 font-sans">
  
  <!-- Header with Header QR Code -->
  <header class="max-w-7xl mx-auto flex items-center justify-between py-4 mb-8 border-b border-slate-200">
    <div>
      <span class="font-extrabold text-2xl tracking-tight text-slate-900">DevCraft AI</span>
      <span class="ml-2 text-[10px] font-mono px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 font-bold border border-indigo-200">Hub</span>
    </div>

    <!-- Header QR Code Widget -->
    <div class="flex items-center gap-3 bg-white p-2 px-3.5 rounded-2xl border border-slate-200 shadow-xs">
      <div class="w-9 h-9 bg-slate-100 p-1 rounded-lg border border-slate-200 shrink-0">
        <img 
          src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=<%= encodeURIComponent(R.base) %>" 
          alt="QR Code Header" 
          class="w-full h-full object-contain" 
        />
      </div>
      <div class="hidden sm:block text-left">
        <div class="text-[11px] font-bold text-slate-900 leading-tight">Accès Mobile QR</div>
        <div class="text-[9.5px] font-mono text-slate-400 truncate max-w-[130px]"><%= R.base %></div>
      </div>
    </div>
  </header>

  <!-- Title & Description Section -->
  <div class="max-w-7xl mx-auto mb-10 text-center sm:text-left space-y-2">
    <h1 class="font-extrabold text-3xl sm:text-5xl text-slate-900 tracking-tight">
      Les sites web que j'ai générés avec l'IA
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 font-medium max-w-2xl leading-relaxed">
      Un aperçu de sites web générés de A à Z avec l'IA en moins de 5 minutes.
    </p>
  </div>

  <!-- Bento Grid Container: Sub-site cards -->
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

    <!-- CARD 1 (Clickable Link): FreshBox Restaurant -->
    <a href="<%= R.base %>/freshbox" class="bg-[#ffc844] text-[#4a1c0d] p-8 rounded-[2.5rem] shadow-xl flex flex-col justify-between border border-[#e6b338] relative overflow-hidden group min-h-[360px] hover:scale-[1.02] transition-transform duration-300">
      <div class="relative z-10 space-y-3">
        <div class="flex items-center justify-between">
          <span class="px-3 py-1 rounded-full bg-[#4a1c0d] text-white font-bold text-[10px] uppercase tracking-wider flex items-center gap-1.5">
            <%- icon('utensils', 'w-3 h-3 text-white') %>
            <span>RESTAURANT SITE</span>
          </span>
        </div>

        <h2 class="font-outfit font-black text-3xl sm:text-4xl uppercase tracking-tight leading-tight text-[#4a1c0d] pt-2 group-hover:underline">
          FreshBox Restaurant
        </h2>
        <p class="text-xs sm:text-sm text-[#5c2414] font-medium leading-relaxed">
          Sub-site de restauration africaine avec menu interactif, système de réservation et panier.
        </p>
      </div>

      <div class="relative z-10 pt-6">
        <div class="inline-flex items-center justify-center w-full py-3.5 px-6 rounded-full bg-[#4a1c0d] group-hover:bg-[#381308] text-white font-black text-xs uppercase tracking-wider shadow-lg transition-colors">
          VISITER FRESHBOX →
        </div>
      </div>
    </a>

    <!-- CARD 2 (Clickable Link): Modulive E-Commerce -->
    <a href="<%= R.base %>/modulive" class="bg-white border-2 border-slate-900 text-slate-900 p-8 rounded-[2.5rem] shadow-xl flex flex-col justify-between relative overflow-hidden group min-h-[360px] hover:scale-[1.02] transition-transform duration-300">
      <div class="relative z-10 space-y-3">
        <div class="flex items-center justify-between">
          <span class="px-3 py-1 rounded-full bg-slate-900 text-white font-bold text-[10px] uppercase tracking-wider flex items-center gap-1.5">
            <%- icon('shopping-bag', 'w-3 h-3 text-white') %>
            <span>E-COMMERCE SITE</span>
          </span>
        </div>

        <h2 class="font-bold text-3xl sm:text-4xl tracking-tight text-slate-900 pt-2 group-hover:underline">
          Modulive Store
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed">
          Boutique e-commerce haut de gamme pour mobilier éco-responsable et artisanat africain.
        </p>
      </div>

      <div class="relative z-10 pt-6">
        <div class="inline-flex items-center justify-center w-full py-3.5 px-6 rounded-full bg-slate-900 group-hover:bg-slate-800 text-white font-black text-xs uppercase tracking-wider shadow-lg transition-colors">
          VISITER MODULIVE →
        </div>
      </div>
    </a>

    <!-- CARD 3 (Clickable Link): Donezo SaaS Dashboard -->
    <a href="<%= R.base %>/donezo" class="bg-[#0d3b24] text-white p-8 rounded-[2.5rem] shadow-xl flex flex-col justify-between relative overflow-hidden group min-h-[360px] hover:scale-[1.02] transition-transform duration-300 border border-[#0a2e1c]">
      <div class="relative z-10 space-y-3">
        <div class="flex items-center justify-between">
          <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold text-[10px] uppercase tracking-wider flex items-center gap-1.5 border border-emerald-500/30">
            <%- icon('bar-chart-3', 'w-3 h-3 text-emerald-300') %>
            <span>SAAS DASHBOARD</span>
          </span>
        </div>

        <h2 class="font-bold text-3xl sm:text-4xl tracking-tight text-white pt-2 group-hover:underline">
          Donezo Dashboard
        </h2>
        <p class="text-xs sm:text-sm text-emerald-100/80 font-medium leading-relaxed">
          Tableau de bord de gestion de projets, suivi des tâches et métriques analytiques.
        </p>
      </div>

      <div class="relative z-10 pt-6">
        <div class="inline-flex items-center justify-center w-full py-3.5 px-6 rounded-full bg-emerald-600 group-hover:bg-emerald-500 text-white font-black text-xs uppercase tracking-wider shadow-lg transition-colors">
          VISITER DONEZO →
        </div>
      </div>
    </a>

    <!-- CARD 4 (Clickable Link): Kabila Studio Portfolio -->
    <a href="<%= R.base %>/agency" class="bg-[#0f0f11] text-white p-8 rounded-[2.5rem] shadow-xl flex flex-col justify-between relative overflow-hidden group min-h-[360px] hover:scale-[1.02] transition-transform duration-300 border border-white/10">
      <div class="relative z-10 space-y-3">
        <div class="flex items-center justify-between">
          <span class="px-3 py-1 rounded-full bg-[#e5b842]/20 text-[#e5b842] font-bold text-[10px] uppercase tracking-wider flex items-center gap-1.5 border border-[#e5b842]/30">
            <%- icon('briefcase', 'w-3 h-3 text-[#e5b842]') %>
            <span>PORTFOLIO & AGENCE</span>
          </span>
        </div>

        <h2 class="font-cinzel font-bold text-3xl sm:text-4xl tracking-tight text-white pt-2 group-hover:underline">
          Kabila Studio
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 font-medium leading-relaxed">
          Agence d'architecture moderne et direction créative d'exception en Afrique.
        </p>
      </div>

      <div class="relative z-10 pt-6">
        <div class="inline-flex items-center justify-center w-full py-3.5 px-6 rounded-full bg-[#e5b842] group-hover:bg-[#d4af37] text-black font-extrabold text-xs uppercase tracking-wider shadow-lg transition-colors">
          VISITER KABILA STUDIO →
        </div>
      </div>
    </a>

    <!-- CARD 5: QR Code Card in Grid -->
    <div class="bg-white border border-slate-200/80 p-8 rounded-[2.5rem] shadow-xs text-center flex flex-col items-center justify-between min-h-[360px]">
      <div class="w-full">
        <span class="text-[10px] font-mono font-bold uppercase text-indigo-600 tracking-wider block mb-1">ACCÈS DIRECT</span>
        <h3 class="font-extrabold text-base text-slate-900">QR Code du Hub</h3>
      </div>

      <div class="w-36 h-36 bg-slate-50 p-3 rounded-2xl border border-slate-200 my-3 shadow-inner">
        <img 
          src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=<%= encodeURIComponent(R.base) %>" 
          alt="QR Code Hub Principal" 
          class="w-full h-full object-contain" 
        />
      </div>

      <div class="w-full">
        <p class="text-xs text-slate-500 font-mono font-medium truncate mb-1">
          <%= R.base %>
        </p>
        <span class="text-[11px] text-slate-400 font-medium">Scannez pour ouvrir l'accueil</span>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <footer class="max-w-7xl mx-auto py-8 mt-12 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
    <div class="font-bold text-slate-900">DevCraft AI Hub © 2026</div>
    <div class="font-mono text-slate-600">Lien Hub : <%= R.base %></div>
  </footer>

</main>