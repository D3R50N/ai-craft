<div class="space-y-6">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="font-extrabold text-3xl text-slate-900 tracking-tight">Tasks Management Board</h1>
      <p class="text-xs text-slate-500 mt-1">Organisez et gérez toutes les tâches de l'équipe.</p>
    </div>

    <button onclick="alert('Nouvelle tâche ajoutée !')" class="px-5 py-2.5 rounded-full bg-[#0d3b24] text-white font-bold text-xs flex items-center gap-2 shadow-xs cursor-pointer">
      <%- icon('plus', 'w-4 h-4') %>
      <span>Nouvelle Tâche</span>
    </button>
  </div>

  <!-- Filter Pills -->
  <div class="flex items-center gap-2 border-b border-slate-200 pb-4">
    <button class="px-4 py-2 rounded-full bg-[#0d3b24] text-white font-bold text-xs">Toutes (12)</button>
    <button class="px-4 py-2 rounded-full bg-slate-100 text-slate-600 font-semibold text-xs hover:bg-slate-200">En cours (5)</button>
    <button class="px-4 py-2 rounded-full bg-slate-100 text-slate-600 font-semibold text-xs hover:bg-slate-200">Terminées (5)</button>
    <button class="px-4 py-2 rounded-full bg-slate-100 text-slate-600 font-semibold text-xs hover:bg-slate-200">En attente (2)</button>
  </div>

  <!-- Task Columns Board -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Column 1: To Do -->
    <div class="bg-[#f9fafa] p-5 rounded-3xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between font-extrabold text-xs text-slate-900">
        <span>À FAIRE (2)</span>
        <span class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-[10px]">2</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-3 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="px-2 py-0.5 rounded bg-red-100 text-red-700 font-bold text-[9px]">Priorité Haute</span>
          <span class="text-[10px] text-slate-400 font-mono">Dec 6</span>
        </div>
        <h4 class="font-bold text-xs text-slate-900">Cross-Browser Testing</h4>
        <p class="text-[11px] text-slate-500">Vérification de la compatibilité Chrome, Safari et Firefox.</p>
      </div>
    </div>

    <!-- Column 2: In Progress -->
    <div class="bg-[#f9fafa] p-5 rounded-3xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between font-extrabold text-xs text-slate-900">
        <span>EN COURS (5)</span>
        <span class="w-5 h-5 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-[10px]">5</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-3 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-bold text-[9px]">En cours</span>
          <span class="text-[10px] text-slate-400 font-mono">Nov 28</span>
        </div>
        <h4 class="font-bold text-xs text-slate-900">Integrate Auth System</h4>
        <p class="text-[11px] text-slate-500">Mise en place de l'authentification sécurisée avec JWT.</p>
      </div>
    </div>

    <!-- Column 3: Completed -->
    <div class="bg-[#f9fafa] p-5 rounded-3xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between font-extrabold text-xs text-slate-900">
        <span>TERMINÉES (5)</span>
        <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-[10px]">5</span>
      </div>

      <div class="p-4 rounded-2xl bg-white border border-slate-200 space-y-3 shadow-xs">
        <div class="flex items-center justify-between">
          <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[9px]">Terminée</span>
          <span class="text-[10px] text-slate-400 font-mono">Nov 26</span>
        </div>
        <h4 class="font-bold text-xs text-slate-900">Develop API Endpoints</h4>
        <p class="text-[11px] text-slate-500">Création des routes RESTful pour la gestion des données.</p>
      </div>
    </div>

  </div>

</div>
