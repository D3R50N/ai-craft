        <%- icon('arrow-up-right', 'w-4 h-4 text-white') %>
      </div>
    </div>
    <div>
      <div class="font-extrabold text-4xl text-white mb-2">24</div>
      <div class="flex items-center gap-1.5 text-[10px] text-emerald-300 font-medium">
        <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 font-bold">5% ▲</span>
        <span>Increased from last month</span>
      </div>
    </div>
  </div>

  <div class="bg-[#f9fafa] border border-slate-200/80 p-6 rounded-3xl flex flex-col justify-between min-h-[140px]">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-slate-700">Ended Projects</span>
      <div class="w-8 h-8 rounded-full bg-slate-200/60 flex items-center justify-center text-slate-700">
        <%- icon('arrow-up-right', 'w-4 h-4') %>
      </div>
    </div>
    <div>
      <div class="font-extrabold text-4xl text-slate-900 mb-2">10</div>
      <div class="flex items-center gap-1.5 text-[10px] text-slate-500 font-medium">
        <span class="px-1.5 py-0.5 rounded bg-slate-200 font-bold text-slate-700">6% ▲</span>
        <span>Increased from last month</span>
      </div>
    </div>
  </div>

  <div class="bg-[#f9fafa] border border-slate-200/80 p-6 rounded-3xl flex flex-col justify-between min-h-[140px]">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-slate-700">Running Projects</span>
      <div class="w-8 h-8 rounded-full bg-slate-200/60 flex items-center justify-center text-slate-700">
        <%- icon('arrow-up-right', 'w-4 h-4') %>
      </div>
    </div>
    <div>
      <div class="font-extrabold text-4xl text-slate-900 mb-2">12</div>
      <div class="flex items-center gap-1.5 text-[10px] text-slate-500 font-medium">
        <span class="px-1.5 py-0.5 rounded bg-slate-200 font-bold text-slate-700">2% ▲</span>
        <span>Increased from last month</span>
      </div>
    </div>
  </div>

  <div class="bg-[#f9fafa] border border-slate-200/80 p-6 rounded-3xl flex flex-col justify-between min-h-[140px]">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold text-slate-700">Pending Project</span>
      <div class="w-8 h-8 rounded-full bg-slate-200/60 flex items-center justify-center text-slate-700">
        <%- icon('arrow-up-right', 'w-4 h-4') %>
      </div>
    </div>
    <div>
      <div class="font-extrabold text-4xl text-slate-900 mb-2">2</div>
      <div class="text-[10px] text-slate-400 font-medium">On Discuss</div>
