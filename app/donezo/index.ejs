<!-- DASHBOARD TITLE & PRIMARY ACTIONS -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <h1 class="font-extrabold text-3xl text-slate-900 tracking-tight">Dashboard</h1>
    <p class="text-xs text-slate-500 mt-1">Plan, prioritize, and accomplish your tasks with ease.</p>
  </div>

  <div class="flex items-center gap-3">
    <button onclick="alert('Nouveau projet créé !')" class="px-5 py-2.5 rounded-full bg-[#0d3b24] hover:bg-[#0a2e1c] text-white font-bold text-xs flex items-center gap-2 shadow-sm transition-all cursor-pointer">
      <%- icon('plus', 'w-4 h-4') %>
      <span>Add Project</span>
    </button>
    <button onclick="alert('Importation des données en cours...')" class="px-5 py-2.5 rounded-full bg-white border border-slate-300 text-slate-700 font-bold text-xs hover:bg-slate-50 transition-all cursor-pointer">
      Import Data
    </button>
  </div>
</div>

<!-- ROW 1: 4 STAT METRIC CARDS -->
