<!DOCTYPE html>
<html lang="fr" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/tailwind.css">
  <style>
    body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; }
    code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>

<body class="bg-[#121212] text-slate-100 min-h-full font-sans antialiased selection:bg-white selection:text-black flex flex-col justify-between">

  <div class="w-full">
    <!-- View Content rendered inside layout -->
    <%- body %>
  </div>

  <!-- PETER MARINO ARCHITECT STYLE FOOTER -->
  <footer class="bg-[#0a0a0a] text-white py-16 px-6 sm:px-12 border-t border-white/10 mt-20">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 text-xs">
      <div class="md:col-span-8 space-y-4">
        <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400">COLLABORATIONS</h4>
        <p class="font-extrabold text-base sm:text-xl text-white max-w-lg uppercase tracking-tight leading-snug">
          TOUJOURS OUVERT AUX NOUVEAUX PROJETS ET COLLABORATIONS — CONTACTEZ NOTRE STUDIO.
        </p>
        <p class="text-xs text-slate-400 font-mono">contact@kabila-architectes.com | +225 07 08 09 10 11</p>
      </div>

      <div class="md:col-span-4 flex flex-col justify-between items-start md:items-end text-slate-400 font-mono text-[11px] space-y-4">
        <div class="flex gap-6 uppercase tracking-wider">
          <a href="<%= R.base %>/agency" class="hover:text-white transition-colors">ACCUEIL</a>
          <a href="<%= R.base %>/agency/projects" class="hover:text-white transition-colors">PROJETS</a>
          <a href="<%= R.base %>/agency/awards" class="hover:text-white transition-colors">DISTINCTIONS</a>
          <a href="<%= R.base %>" class="hover:text-white transition-colors">HUB</a>
        </div>

        <div>© 2026 KABILA STUDIO ARCHITECTES.</div>
      </div>
    </div>
  </footer>

  <!-- Contact Modal -->
  <div id="contactModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md">
    <div class="w-full max-w-lg bg-[#1a1a1a] border border-white/20 p-8 text-white relative shadow-2xl">
      <button onclick="document.getElementById('contactModal').classList.add('hidden')" class="absolute top-5 right-5 p-2 text-slate-400 hover:text-white transition-colors cursor-pointer">
        <%- icon('x', 'w-5 h-5') %>
      </button>

      <div class="mb-6 space-y-1">
        <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest block">CONTACT STUDIO</span>
        <h3 class="font-extrabold text-xl tracking-tight text-white uppercase">Démarrer une Collaboration</h3>
      </div>

      <form onsubmit="alert('Message envoyé au studio ! Nous vous recontacterons.'); document.getElementById('contactModal').classList.add('hidden'); return false;" class="space-y-4 text-xs font-semibold">
        <div>
          <label class="block mb-1 text-slate-300">Nom & Prénom</label>
          <input type="text" required placeholder="Alexandre N'Guessan" class="w-full px-4 py-3 bg-black border border-white/20 text-white focus:outline-none focus:border-white" />
        </div>

        <div>
          <label class="block mb-1 text-slate-300">Adresse Email</label>
          <input type="email" required placeholder="alex@entreprise.com" class="w-full px-4 py-3 bg-black border border-white/20 text-white focus:outline-none focus:border-white" />
        </div>

        <div>
          <label class="block mb-1 text-slate-300">Projet Architectural</label>
          <textarea rows="3" required placeholder="Musée, tour résidentielle, aménagement d'espace..." class="w-full px-4 py-3 bg-black border border-white/20 text-white focus:outline-none focus:border-white"></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-white text-black font-extrabold text-xs uppercase tracking-widest transition-colors cursor-pointer">
          ENVOYER LE MESSAGE
        </button>
      </form>
    </div>
  </div>

</body>
</html>
