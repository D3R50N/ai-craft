<main class="max-w-7xl mx-auto px-6 sm:px-12 py-16 space-y-16">
  
  <div class="space-y-4 text-center sm:text-left">
    <span class="text-xs font-mono text-[#e5b842] uppercase tracking-widest block">• SÉLECTION ARCHITECTURALE</span>
    <h1 class="font-cinzel font-bold text-4xl sm:text-6xl text-white uppercase tracking-tight">
      Réalisations du Studio
    </h1>
    <p class="text-xs sm:text-sm text-slate-400 font-light max-w-xl leading-relaxed">
      Découvrez nos projets emblématiques alliant innovation structurelle et expression culturelle.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <% projects.forEach(function(item) { %>
      <div class="space-y-4 group cursor-pointer bg-[#141417] p-6 rounded-3xl border border-white/10">
        <div class="w-full h-80 rounded-2xl overflow-hidden bg-slate-900 relative">
          <img src="<%= item.image %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter grayscale group-hover:grayscale-0" />
          <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md text-[10px] font-mono text-[#e5b842] border border-white/10">
            <%= item.year %>
          </div>
        </div>

        <div class="space-y-1 pt-2">
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest"><%= item.category %></span>
          <h3 class="font-cinzel font-bold text-xl text-white group-hover:text-[#e5b842] transition-colors"><%= item.title %></h3>
          <p class="text-xs text-slate-400 font-mono"><%= item.location %></p>
        </div>
      </div>
    <% }); %>
  </div>

</main>
