<!DOCTYPE html>
<html lang="fr" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/tailwind.css">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>

<body class="bg-[#f8f8f6] text-slate-900 min-h-full font-sans antialiased selection:bg-slate-900 selection:text-white flex flex-col justify-between">

  <div>
    <!-- NAVBAR IN FRENCH -->
    <header class="w-full px-6 sm:px-12 py-6 flex items-center justify-between border-b border-slate-200/60 sticky top-0 z-50 bg-[#f8f8f6]/90 backdrop-blur-md">
      <a href="<%= R.base %>/modulive" class="flex items-center gap-2 font-bold text-xl tracking-tight text-slate-900">
        <%- icon('sparkle', 'w-5 h-5 text-slate-900') %>
        <span>Modulive Afrique</span>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-xs font-semibold text-slate-600">
        <a href="<%= R.base %>/modulive" class="hover:text-slate-900 transition-colors">Accueil</a>
        <a href="<%= R.base %>/modulive/products" class="hover:text-slate-900 transition-colors">Catalogue Mobilier</a>
        <a href="<%= R.base %>" class="hover:text-slate-900 transition-colors">← Portail Hub</a>
      </nav>

      <div class="flex items-center gap-4 text-slate-700">
        <a href="<%= R.base %>/modulive/products" class="p-2 hover:text-slate-900 transition-colors">
          <%- icon('search', 'w-4 h-4') %>
        </a>
        <button onclick="document.getElementById('cartModal').classList.remove('hidden')" class="p-2 hover:text-slate-900 transition-colors relative cursor-pointer">
          <%- icon('shopping-bag', 'w-4 h-4') %>
          <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-slate-900 text-white font-bold text-[9px] flex items-center justify-center">1</span>
        </button>
      </div>
    </header>

    <%- body %>
  </div>

  <!-- FOOTER IN FRENCH -->
  <footer class="bg-[#1c1c1c] text-white py-12 px-6 sm:px-12 mt-16 border-t border-slate-800">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 text-xs text-slate-400 border-b border-slate-800 pb-8 mb-8">
      <div class="space-y-3">
        <div class="flex items-center gap-2 font-bold text-lg text-white">
          <%- icon('sparkle', 'w-5 h-5') %>
          <span>Modulive Afrique</span>
        </div>
        <p class="text-slate-400">Artisanat & Mobilier Éco-Responsable en Bois Noble.</p>
      </div>

      <div>
        <h4 class="font-bold text-white mb-3">Service Client</h4>
        <ul class="space-y-2">
          <li><a href="#" class="hover:text-white">Mentions Légales</a></li>
          <li><a href="#" class="hover:text-white">Protection des Données</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-3">Navigation</h4>
        <ul class="space-y-2">
          <li><a href="<%= R.base %>/modulive" class="hover:text-white">Accueil</a></li>
          <li><a href="<%= R.base %>/modulive/products" class="hover:text-white">Catalogue</a></li>
          <li><a href="<%= R.base %>" class="hover:text-white">Portail Hub</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-3">Contact</h4>
        <p>Avenue de la Grande Armée, Abidjan</p>
        <p class="mt-1">contact@modulive-afrique.com</p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500">
      <div>© Copyright 2026. Modulive Afrique. Tous Droits Réservés.</div>
    </div>
  </footer>

  <!-- Shopping Cart Modal in French -->
  <div id="cartModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-2xl relative text-slate-900">
      <button onclick="document.getElementById('cartModal').classList.add('hidden')" class="absolute top-5 right-5 p-2 text-slate-400 hover:text-slate-900 rounded-full transition-colors cursor-pointer">
        <%- icon('x', 'w-5 h-5') %>
      </button>

      <div class="mb-6">
        <h3 class="font-extrabold text-2xl tracking-tight text-slate-900">VOTRE PANIER</h3>
        <p class="text-xs text-slate-500 mt-1">Articles ajoutés au panier</p>
      </div>

      <div class="space-y-3 mb-6">
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs font-bold">
          <span>Canapé Bois d'Iroko</span>
          <span class="font-extrabold">185 000 FCFA</span>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-200 flex items-center justify-between font-extrabold text-lg mb-6">
        <span>TOTAL:</span>
        <span class="text-slate-900">185 000 FCFA</span>
      </div>

      <button onclick="alert('Commande de mobilier effectuée avec succès !'); document.getElementById('cartModal').classList.add('hidden')" class="w-full py-3.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase shadow-md transition-all cursor-pointer">
        VALIDER LA COMMANDE
      </button>
    </div>
  </div>

</body>
</html>
