<main class="max-w-7xl mx-auto px-6 sm:px-12 py-12 space-y-12">
  
  <div class="text-center space-y-3">
    <span class="text-xs font-bold text-[#ffaa00] uppercase tracking-widest block">• CARTE DU RESTAURANT</span>
    <h1 class="font-outfit font-black text-4xl sm:text-6xl text-[#4a1c0d] uppercase tracking-tight">
      Weekly Full Menu
    </h1>
    <p class="text-xs sm:text-sm text-[#5c2414] max-w-xl mx-auto font-medium">
      Tous nos plats sont préparés à la commande par nos chefs.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% items.forEach(function(dish) { %>
      <div class="bg-white border-2 border-[#3d1508] rounded-3xl p-6 shadow-xl flex flex-col justify-between space-y-4">
        <div class="w-full h-48 rounded-2xl overflow-hidden bg-black">
          <img src="<%= dish.image %>" alt="<%= dish.name %>" class="w-full h-full object-cover" />
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between font-outfit font-black text-lg text-[#4a1c0d]">
            <h3><%= dish.name %></h3>
            <span class="text-[#ffaa00]">$<%= dish.price.toFixed(2) %></span>
          </div>
          <p class="text-xs text-[#5c2414] font-medium leading-relaxed">
            <%= dish.description %>
          </p>
        </div>

        <button 
          onclick="alert('Commander <%= dish.name %> !')"
          class="w-full py-3 rounded-full bg-[#ffc844] hover:bg-[#f2b930] text-[#3d1508] font-black text-xs uppercase shadow-md transition-all cursor-pointer">
          AJOUTER AU PANIER
        </button>
      </div>
    <% }); %>
  </div>

</main>
