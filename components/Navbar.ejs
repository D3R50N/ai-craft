<header class="w-full px-6 sm:px-12 py-5 flex items-center justify-between border-b border-[#ebdcc4]/60 bg-[#fcf7ee]/90 backdrop-blur-md sticky top-0 z-50">
  <!-- Brand Logo pointing to /freshbox sub-site -->
  <a href="/freshbox" class="flex items-center gap-2 group">
    <span class="font-outfit font-extrabold text-2xl sm:text-3xl tracking-tight text-[#ffaa00] group-hover:opacity-90 transition-opacity">
      FreshBox
    </span>
  </a>

  <!-- Navigation Links pointing to /freshbox sub-routes -->
  <nav class="hidden lg:flex items-center gap-7 text-xs font-bold text-[#5c2414]">
    <a href="/freshbox#menu" class="hover:text-[#ffaa00] transition-colors">Weekly Menu</a>
    <a href="/freshbox#plans" class="hover:text-[#ffaa00] transition-colors">Plans</a>
    <a href="/freshbox#market" class="hover:text-[#ffaa00] transition-colors">Market</a>
    <a href="/freshbox#recipes" class="hover:text-[#ffaa00] transition-colors">Recipes</a>
    <a href="/freshbox#about" class="hover:text-[#ffaa00] transition-colors">About</a>
    <a href="/freshbox#contact" class="hover:text-[#ffaa00] transition-colors">Contact</a>
  </nav>

  <!-- Right Actions: Search & Order CTA -->
  <div class="flex items-center gap-3">
    <button aria-label="Rechercher" class="w-9 h-9 rounded-full bg-[#f2e4cf] hover:bg-[#e6d5bd] text-[#3d1508] flex items-center justify-center transition-colors cursor-pointer">
      <%- icon('search', 'w-4 h-4') %>
    </button>

    <button 
      onclick="document.getElementById('reservationModal').classList.remove('hidden')"
      class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-[#3d1508] text-[#3d1508] hover:bg-[#3d1508] hover:text-white font-extrabold text-xs transition-colors cursor-pointer">
      BOOK A TABLE
    </button>

    <button 
      onclick="document.getElementById('cartModal').classList.remove('hidden')"
      class="px-6 py-2.5 rounded-full bg-[#ffc844] hover:bg-[#f2b930] text-[#3d1508] font-extrabold text-xs shadow-md shadow-[#ffc844]/20 transition-all hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-2">
      <%- icon('shopping-bag', 'w-4 h-4') %>
      <span>ORDER NOW</span>
    </button>
  </div>
</header>
